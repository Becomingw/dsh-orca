{
  "name": "dsh-orca",
  "version": "0.8.0",
  "description": "Remote fleet for DeepSeek Harness: check, read and run on trusted SSH hosts while decisions stay local.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ssh",
    "remote",
    "gpu",
    "tmux",
    "fleet"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Becomingw/dsh-orca.git"
  },
  "homepage": "https://github.com/Becomingw/dsh-orca#readme",
  "bugs": {
    "url": "https://github.com/Becomingw/dsh-orca/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "engine/*.py",
    "engine/UPSTREAM_COMMIT",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && python3 -m pytest -q tests/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "manifestVersion": 1
  }
}
